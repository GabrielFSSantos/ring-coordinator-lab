# PC 1 (Gabriel) — Wi-Fi 192.168.3.131
# Use com: docker compose --profile storage --profile nodes --env-file lab.env up --build
# (recomendado para 8 nós com PC2; profile local anuncia 172.25.0.x e o PC2 não entra no anel)
#
# Copiar: cp configs/pc1-gabriel-8nodes.lab.env lab.env

LAB_HOST_NAME=pc-gabriel

STORAGE_MODE=primary
STORAGE_HTTP_PORT=4000
STORAGE_URL=http://192.168.3.131:4000
STORAGE_WRITE_TOKEN=lab-write-token
# Caminhos dentro do container lan-storage (compose monta ./data → /data)
DATABASE_PATH=/data/ledger.db
LEDGER_SCHEMA_PATH=/app/schema-ledger.sql
LEDGER_INITIAL_BALANCE=10000.00
LEDGER_RESET_ON_START=true
STORAGE_URL_REQUIRED=true

USE_STORAGE_HTTP=true

ADVERTISE_HOST=192.168.3.131
ADVERTISE_PORT_BASE=3002
NODE_COUNT=4

DISCOVERY_MODE=manual
CLUSTER_PEERS=192.168.3.131:3002,192.168.3.131:3003,192.168.3.131:3004,192.168.3.131:3005,192.168.3.125:3006,192.168.3.125:3007,192.168.3.125:3008,192.168.3.125:3009
BOOTSTRAP_PEER=

SIM_MODE=manual
SIM_TX_BURST=1
SIM_TX_JITTER_MS=0
SIM_DELTA_MIN=-500
SIM_DELTA_MAX=500

LOG_ENABLED=true
LOG_WRITES=true
LOG_ELECTION=true
LOG_QUEUE=true
LOG_STORAGE=true
LOG_TIMELINE_PERSIST=true
LOG_STDOUT_MODE=off

CLIENT_BUFFER_ON_LEADER_LOSS=true
DISCARD_ON_STORAGE_DOWN=true
CLIENT_BUFFER_LIMIT=50
NODE_HTTP_PORT_OFFSET=1000
