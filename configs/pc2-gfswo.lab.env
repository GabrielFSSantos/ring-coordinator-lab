# PC 2 (gfswo) — Wi-Fi 192.168.3.125
# PC 1 (Gabriel) — banco em 192.168.3.131:4000
# Uso: cp configs/pc2-gfswo.lab.env lab.env && ./scripts/run-on-pc-b.sh

STORAGE_URL=http://192.168.3.131:4000
STORAGE_URL_REQUIRED=true
STORAGE_WRITE_TOKEN=lab-write-token
STORAGE_HTTP_PORT=4000
STORAGE_MODE=none
USE_STORAGE_HTTP=true

LAB_HOST_NAME=pc-gfswo
ADVERTISE_HOST=192.168.3.125
ADVERTISE_PORT_BASE=3006
NODE_COUNT=4

DISCOVERY_MODE=manual
CLUSTER_PEERS=192.168.3.131:3002,192.168.3.131:3003,192.168.3.131:3004,192.168.3.131:3005,192.168.3.125:3006,192.168.3.125:3007,192.168.3.125:3008,192.168.3.125:3009
BOOTSTRAP_PEER=

DATABASE_PATH=./data/ledger.db
LEDGER_SCHEMA_PATH=./schema-ledger.sql
LEDGER_INITIAL_BALANCE=10000.00
LEDGER_RESET_ON_START=false

SIM_MODE=manual
SIM_TX_BURST=1
SIM_TX_JITTER_MS=0
SIM_DELTA_MIN=-500
SIM_DELTA_MAX=500

LOG_ENABLED=true
LOG_WRITES=true
LOG_READS=false
LOG_ELECTION=true
LOG_QUEUE=true
LOG_STORAGE=true
LOG_TIMELINE_PERSIST=true
LOG_STDOUT_MODE=off
LOG_FORMAT=human
LOG_STYLE=box
LOG_DETAIL=false
LOG_TX_STORY=true

CLIENT_BUFFER_ON_LEADER_LOSS=true
DISCARD_ON_STORAGE_DOWN=true
CLIENT_BUFFER_LIMIT=50
NODE_HTTP_PORT_OFFSET=1000
