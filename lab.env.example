# Copie ou deixe ./lab gerar lab.env

LAB_RUNTIME=docker
LAB_ROLE=host
LAB_COMPONENTS=host
LAB_HOST_NAME=meu-pc
ADVERTISE_HOST=
ADVERTISE_PORT_BASE=3002
NODE_COUNT=4

STORAGE_MODE=primary
STORAGE_URL=http://127.0.0.1:4000
STORAGE_WRITE_TOKEN=lab-write-token
USE_STORAGE_HTTP=true

DISCOVERY_MODE=mdns

# host (./lab start): TX + renúncia do líder após tenure
SIM_MODE=manual
SIM_TX_ENABLED=true
SIM_LEADER_SELF_TERM=true
SIM_LEADER_TENURE_MS=90000
SIM_TX_BURST=1

LOG_STDOUT_MODE=off
LOG_TIMELINE_PERSIST=true
LOG_FORMAT=human
LOG_STYLE=box
