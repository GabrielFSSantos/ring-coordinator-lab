# =============================================================================
# Um único lab.env para Docker local, LAN e npm run
#   cp lab.env.example lab.env
# Referência: docs/plans/finalizacao-backend-operacao/16-lab-env-referencia-comportamento.md
# =============================================================================
#
# --- Como subir (escolha um) ---
#
# Docker local (4 nós + banco na bridge 172.25.0.x):
#   docker compose --profile local --env-file lab.env up --build
#   (ou: ./scripts/lan-up.sh local)
#
# LAN — só ledger neste PC (+ lab-tail global):
#   docker compose --profile storage --env-file lab.env up --build
#   docker compose --profile storage logs -f lan-tail
#
# LAN — só nós (STORAGE_URL aponta para o PC do banco):
#   docker compose --profile nodes --env-file lab.env up --build
#
# LAN — ledger + nós no mesmo PC:
#   docker compose --profile storage --profile nodes --env-file lab.env up --build
#
# Sem Docker:
#   cd src && npm run storage    # PC do banco
#   cd src && npm run server     # qualquer PC (1+ nós)
#
# =============================================================================
# A — Banco na rede (todos com o MESMO valor após o slide / chat)
# =============================================================================
STORAGE_URL=http://COLOQUE_IP_DO_BANCO_NA_REDE:4000
STORAGE_WRITE_TOKEN=lab-write-token
STORAGE_HTTP_PORT=4000

# =============================================================================
# B — Identidade DESTE computador (cada pessoa ajusta)
# =============================================================================
# Nome deste PC nos títulos dos logs e na UI (único por máquina na LAN)
LAB_HOST_NAME=meu-host
ADVERTISE_HOST=COLOQUE_IP_LAN_DESTE_PC
ADVERTISE_PORT_BASE=3002
# Compose LAN: 1–4 processos nó no supervisor; sala com muitos PCs → 1
NODE_COUNT=1

# =============================================================================
# C — Modo LAN (descomente / use na Wi‑Fi; Docker local use bloco D)
# =============================================================================
DISCOVERY_MODE=mdns
# Se mDNS falhar (WSL2): DISCOVERY_MODE=manual e liste os 8 host:port:
# CLUSTER_PEERS=IP_A:3002,IP_A:3003,...,IP_B:3009
CLUSTER_PEERS=
BOOTSTRAP_PEER=
STORAGE_URL_REQUIRED=true

# =============================================================================
# D — Modo Docker local (profile local) — copie estes valores no lab.env de dev
# =============================================================================
# STORAGE_URL=http://172.25.0.10:4000
# ADVERTISE_HOST=127.0.0.1
# DISCOVERY_MODE=off
# CLUSTER_PEERS=172.25.0.2:3002,172.25.0.3:3003,172.25.0.4:3004,172.25.0.5:3005
# STORAGE_URL_REQUIRED=false

# Nós usam STORAGE_URL fixo; não gravam SQLite local no líder
USE_STORAGE_HTTP=true
STORAGE_MODE=none
DATABASE_PATH=./data/ledger.db
LEDGER_SCHEMA_PATH=./schema-ledger.sql
LEDGER_INITIAL_BALANCE=10000.00
# true = apaga timeline/ledger no boot do storage (demo limpa); LAN: false para manter histórico
LEDGER_RESET_ON_START=true

DISCOVERY_POLL_MS=5000

SIM_MODE=manual
# 1 transação por ciclo; intervalo distinto por nó (compose) ou fallback 10/5/8/7 s por porta
SIM_TX_BURST=1
# SIM_TX_INTERVAL_MS=10000
# SIM_TX_INITIAL_STAGGER_MS=   # vazio = (porta - base) * 1s no primeiro ciclo
SIM_TX_JITTER_MS=0
SIM_DELTA_MIN=-500
SIM_DELTA_MAX=500
SIM_LEADER_KILL_INTERVAL_MS=120000
SIM_LEADER_KILL_INITIATOR=

LOG_ENABLED=true
LOG_WRITES=true
LOG_READS=false
LOG_ELECTION=true
LOG_QUEUE=true
LOG_STORAGE=true
LOG_SIM=false
# human = narrativa PT-BR; structured = linha única (scripts/UI)
LOG_FORMAT=human
# box = caixas Unicode; plain = linhas simples
LOG_STYLE=box
# false = sem códigos técnicos no texto; true = mostra [EVENT] e ids
LOG_DETAIL=false
# true = uma caixa por transação no coordenador
LOG_TX_STORY=true
# 0 = não repete resumo do grupo; ex. 60000 para demo longa
LOG_RING_VIEW_INTERVAL_MS=0
# Grava eventos no storage (timeline global multi-PC)
LOG_TIMELINE_PERSIST=true
# LOG_TIMELINE_SKIP_CODES=RING_VIEW,TX_STORY
# direct = stdout no processo; off = silencioso; timeline_self / timeline_all = poll no storage
LOG_STDOUT_MODE=direct
LOG_TIMELINE_POLL_MS=400
# Linhas [lab-ops] no stderr quando stdout não é direct (compose up)
# LOG_DOCKER_OPS=true
# Docker local (compose): nós/storage usam off; serviço lab-tail usa timeline_all

CLIENT_BUFFER_ON_LEADER_LOSS=true
DISCARD_ON_STORAGE_DOWN=true
CLIENT_BUFFER_LIMIT=50
NODE_HTTP_PORT_OFFSET=1000
