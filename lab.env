# Perfil local: docker compose (4 nós + storage em 172.25.0.0/16)
# Uso: docker compose --profile local --env-file lab.env up --build
# LAN / npm local: copie de lab.env.example e ajuste ADVERTISE_HOST + CLUSTER_PEERS

LAB_HOST_NAME=docker-lab

STORAGE_MODE=primary
STORAGE_HTTP_PORT=4000
STORAGE_URL=http://172.25.0.10:4000
STORAGE_DISCOVERY_URL=
STORAGE_WRITE_TOKEN=lab-write-token
DATABASE_PATH=/data/ledger.db
LEDGER_SCHEMA_PATH=/app/schema-ledger.sql
LEDGER_INITIAL_BALANCE=10000.00
LEDGER_RESET_ON_START=true

USE_STORAGE_HTTP=true

IP_LIST=172.25.0.2,172.25.0.3,172.25.0.4,172.25.0.5
CLUSTER_PEERS=172.25.0.2:3002,172.25.0.3:3003,172.25.0.4:3004,172.25.0.5:3005
BOOTSTRAP_PEER=

ADVERTISE_PORT_BASE=3002
NODE_COUNT=1

SIM_MODE=manual
SIM_TX_BURST=1
# Intervalo por nó: override no docker-compose (10s/5s/8s/7s) ou fallback por porta no env.js
SIM_TX_JITTER_MS=0
SIM_DELTA_MIN=-500
SIM_DELTA_MAX=500
SIM_LEADER_KILL_INTERVAL_MS=120000
SIM_LEADER_KILL_INITIATOR=

LOG_ENABLED=true
LOG_WRITES=true
LOG_READS=false
LOG_ELECTION=true
LOG_QUEUE=true
LOG_STORAGE=true
LOG_TIMELINE_PERSIST=true
LOG_STDOUT_MODE=off

CLIENT_BUFFER_ON_LEADER_LOSS=true
DISCARD_ON_STORAGE_DOWN=true
CLIENT_BUFFER_LIMIT=50

NODE_HTTP_PORT_OFFSET=1000
